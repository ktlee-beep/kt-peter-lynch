# KT Trading API — Environment Variables
# Copy to .env and fill in values before running locally

# ── Authentication ─────────────────────────────────
# Master admin credentials for initial user creation
MASTER_EMAIL=admin@example.com
MASTER_PASS=changeme

# JWT signing secret (use a long random string)
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars

# ── Database (Supabase) ────────────────────────────
# Supabase project URL (Settings > API > Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (Settings > API > service_role secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase direct PostgreSQL connection URL (Settings > Database > URI)
# Used for pg pooler fallback: try Session Pooler (port 5432) or Transaction Pooler (port 6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── External APIs ──────────────────────────────────
# DART Open API key (https://opendart.fss.or.kr) — financial statements
DART_API_KEY=your_dart_api_key_here

# Korea Exchange (KRX) service key — not currently used actively
KRX_SERVICE_KEY=your_krx_service_key_here

# Google Gemini API key (https://aistudio.google.com/app/apikey)
# Free tier: 15 req/min, 1,500 req/day — Gemini 2.0 Flash
GEMINI_API_KEY=AIzaSy...

# ── 이메일 발송 (회원가입 인증코드 / Gmail SMTP) ──
# Gmail 2단계 인증 활성화 후 "앱 비밀번호"를 발급받아 사용 (일반 비밀번호 아님)
# 발급: Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호 (https://myaccount.google.com/apppasswords)
# 미설정 시 실제 메일 발송 대신 서버 콘솔에 인증코드가 출력됩니다 (개발 모드).
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# (선택) 발신자 표기. 기본값: "KT 트레이딩 <GMAIL_USER>"
MAIL_FROM=KT 트레이딩 <yourname@gmail.com>

# ── CORS / Origin ─────────────────────────────────
# Allowed frontend origin (Cloudflare Worker or localhost for dev)
FRONTEND_ORIGIN=http://localhost:5173

# ── Cron / Scheduled Jobs ─────────────────────────
# Secret token for /api/cron/scan endpoint (called by external cron)
SCAN_SECRET=your_scan_secret_here

# ── Server ─────────────────────────────────────────
PORT=3000
NODE_ENV=development
